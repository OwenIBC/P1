    <!-- Errores de validación                                        -->
    <!-- ============================================================ -->
    <string name="error_required">Campo obligatorio</string>
    <string name="error_invalid_number">Introduce un número válido</string>
    <string name="error_must_be_positive">Debe ser mayor que 0</string>
    <string name="error_must_be_non_negative">Debe ser mayor o igual que 0</string>
    <string name="error_angle_range_180">El ángulo debe estar entre 0° y 180°</string>
    <string name="error_angle_range_90">El ángulo de incidencia debe estar entre 0° y 90°</string>
    <string name="error_below_absolute_zero">No puede ser inferior al cero absoluto (−273.15 °C)</string>
    <string name="error_t1_not_greater">T₁ debe ser mayor que T₂</string>
    <string name="error_t2_not_lower">T₂ debe ser menor que T₁</string>
    <string name="error_refractive_index">El índice de refracción debe ser mayor o igual que 1</string>
    <string name="error_total_internal_reflection">Reflexión total interna: θ₁ supera el ángulo crítico (%1$s°)</string>
    <string name="error_result_out_of_range">El resultado excede el rango numérico representable</string>

