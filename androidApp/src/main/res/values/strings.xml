    <string name="settings_section_audio">Audio</string>
    <string name="settings_sound_title">Efectos de sonido</string>
    <string name="settings_sound_summary">Reproducir audios al validar o calcular</string>
    <string name="settings_section_history">Historial de la sesión</string>
    <string name="settings_clear_history">Borrar historial</string>
    <string name="settings_section_about">Acerca de</string>
    <string name="settings_about_body">Calculadora de física con cuatro fórmulas: fuerza magnética, conducción de calor, energía cinética y ley de Snell. Todos los valores se expresan en unidades del Sistema Internacional (temperaturas en °C y ángulos en grados).</string>
    <string name="dialog_clear_history_title">¿Borrar historial?</string>
    <string name="dialog_clear_history_message">Se eliminarán todos los cálculos de esta sesión.</string>
    <string name="dialog_confirm_clear">Borrar</string>
    <string name="dialog_cancel">Cancelar</string>

